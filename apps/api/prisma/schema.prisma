// ─── S50 Outbound Webhooks ────────────────────────────────────────────────────

enum WebhookEvent {
  COMPANY_CREATED
  COMPANY_UPDATED
  CONTACT_CREATED
  DEAL_CREATED
  DEAL_STATUS_CHANGED
  INVOICE_ISSUED
  QUOTE_ACCEPTED
  CALL_COMPLETED
  APPROVAL_DECIDED
  // Phase 1 — close the loop between F1 (email tracking) and F3 (webhooks).
  // Additive; existing subscriptions ignore new events unless re-configured.
  CAMPAIGN_SENT
  CAMPAIGN_COMPLETED
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_BOUNCED
  EMAIL_UNSUBSCRIBED
  EMAIL_SPAM_REPORTED
}

model WebhookEndpoint {
  id                  String         @id @default(cuid())
  tenantId            String         @map("tenant_id")
  url                 String
  /// BLOCKER 2 phase 1: plaintext kept ADDITIVELY alongside secretEncrypted
  /// for 30 days. Phase 1.6 cleanup migration backfills + DROPs this column
  /// once dual-write is confirmed across all replicas + workers.
  secret              String
  /// Envelope-encrypted secret (base64url(ciphertext||tag||iv)). Set by the
  /// app layer at create + rotate time. NULL until the dual-write migration
  /// ships in Phase 1.0+ (this column added in Phase 1.0 = additive).
  secretEncrypted     String?        @map("secret_encrypted") @db.VarChar(1024)
  /// KMS key id used to wrap the data key. Allows offline rotation
  /// introspection (which keys are still in use, when to retire one).
  secretKid           String?        @map("secret_kid") @db.VarChar(64)
  events              WebhookEvent[]
  isActive            Boolean        @default(true) @map("is_active")
  /// Optional human description shown in the admin UI ("Slack #sales").
  description         String?        @db.VarChar(512)
  /// Operational health counters maintained by the delivery worker.
  consecutiveFailures Int            @default(0) @map("consecutive_failures")
  lastDeliveryAt      DateTime?      @map("last_delivery_at")
  lastSuccessAt       DateTime?      @map("last_success_at")
  /// Auto-disable bookkeeping (410 Gone repeats, failure threshold trips).
  disabledAt          DateTime?      @map("disabled_at")
  disabledReason      String?        @map("disabled_reason") @db.VarChar(256)
  /// Audit: which user registered this endpoint. NULL for system-created.
  createdById         String?        @map("created_by_id")
  /// T-WH-T-03 secret rotation 24h grace window. When rotate is called we
  /// move the current envelope-encrypted secret into previousSecretEncrypted
  /// and set previousSecretValidUntil = now() + 24h. The delivery processor
  /// signs with BOTH (sending two signatures `v1=...,v1prev=...`) for the
  /// grace window so subscribers have time to roll over without lost events.
  previousSecretEncrypted  String?    @map("previous_secret_encrypted") @db.VarChar(1024)
  previousSecretKid        String?    @map("previous_secret_kid") @db.VarChar(64)
  previousSecretValidUntil DateTime?  @map("previous_secret_valid_until")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([tenantId])
  // Phase 1 — partial index "active endpoints per tenant" is created
  // hand-rolled in SQL (webhook_endpoints_tenant_active_idx). Prisma can't
  // express the WHERE filter.
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id              String    @id @default(cuid())
  // P0-3 (audit 4-agent): tenantId added so RLS + Prisma extension scope
  // this sub-resource. Pre-fix, queries on webhook_deliveries bypassed RLS.
  tenantId        String    @map("tenant_id")
  endpointId      String    @map("endpoint_id")
  event           String
  payload         Json
  statusCode      Int?      @map("status_code")
  responseBody    String?   @map("response_body")
  attempt         Int       @default(1)
  success         Boolean   @default(false)
  // Phase 1 — retry orchestration + idempotency + signature audit
  /// SHA-256 hex of canonicalized payload JSON. Idempotency across retries.
  payloadHash     String?   @map("payload_hash") @db.Char(64)
  /// App-supplied dedup key (e.g., outbox_event_id::endpoint_id). Sent in
  /// X-Idempotency-Key header so naive receivers can dedupe.
  idempotencyKey  String?   @map("idempotency_key") @db.VarChar(128)
  /// The X-Amass-Signature value we sent. Persisted for replay verification.
  signature       String?   @db.VarChar(256)
  /// KMS key id used for the HMAC at send time (matches endpoint.secretKid).
  signatureKid    String?   @map("signature_kid") @db.VarChar(64)
  /// Provider-returned headers (truncated). JSONB for ad-hoc queries.
  responseHeaders Json?     @map("response_headers")
  /// Per-delivery retry envelope. Default 8 matches BullMQ backoff plan
  /// (30s, 1m, 5m, 30m, 2h, 6h, 1d, 3d).
  maxAttempts     Int       @default(8) @map("max_attempts")
  /// When the BullMQ poller should pick this row up again. NULL after
  /// success OR deadLetter = TRUE (no further retries).
  nextAttemptAt   DateTime? @map("next_attempt_at")
  /// Terminal state — attempts exhausted or receiver returned 410 Gone.
  /// Admin UI lists these for manual replay.
  deadLetter      Boolean   @default(false) @map("dead_letter")
  /// End-to-end network time (DNS + TCP + TLS + send + receive).
  durationMs      Int?      @map("duration_ms")
  /// When this delivery row finalized (success OR deadLetter).
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([tenantId])
  // Phase 1 — partial indexes for retry poller + DLQ listing are created
  // hand-rolled in SQL (webhook_deliveries_retry_pending_idx +
  // webhook_deliveries_dead_letter_idx). Prisma can't express WHERE filters.
  @@map("webhook_deliveries")
}

// ─── Phase 1 F3 Outbox pattern ────────────────────────────────────────────────
// CLAUDE.md rule #3 + threat model T-WH-T-05: Promise.allSettled fire-and-forget
// dispatch loses deliveries on restart. The outbox table is INSERTed in the
// SAME transaction as the business write — atomicity guarantees no event is
// emitted unless the business row also committed. A separate BullMQ poller
// drains PENDING rows every 5s and enqueues per-endpoint delivery jobs.

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id            String            @id @default(cuid())
  tenantId      String            @map("tenant_id")
  /// Stringified WebhookEvent enum so future event types added to the enum
  /// don't require an outbox schema migration before they can be published.
  eventType     String            @map("event_type") @db.VarChar(64)
  /// Optional aggregate context — lets the FE/audit show "this outbox row
  /// originated from Deal abc123" without parsing the payload.
  aggregateType String?           @map("aggregate_type") @db.VarChar(64)
  aggregateId   String?           @map("aggregate_id") @db.VarChar(64)
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  /// Number of times the poller has tried to dispatch this row. Bumped on
  /// transient failures (e.g., Redis down → enqueue throws). Bounded retry.
  attempts      Int               @default(0)
  /// Last error message from a failed dispatch (truncated, no PII).
  lastError     String?           @map("last_error") @db.VarChar(512)
  publishedAt   DateTime?         @map("published_at")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  // Hot-path partial index for the poller: scan only PENDING rows ordered
  // by creation. Defined hand-rolled in SQL (outbox_events_pending_idx).
  @@map("outbox_events")
}

