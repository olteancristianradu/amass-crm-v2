// ─── S40 SSO / SAML ──────────────────────────────────────────────────────────

model SsoConfig {
  id                String   @id @default(cuid())
  tenantId          String   @unique @map("tenant_id")
  // IdP metadata — paste the SSO URL + public cert from your IdP dashboard
  idpSsoUrl         String   @map("idp_sso_url")
  // M-aud-M5: SAML signing material is encrypted at rest. The IdP cert
  // is technically a public key but we still encrypt it because tenants
  // sometimes paste private intermediate certs by mistake — encrypting
  // both columns means a DB breach yields ciphertext, not signing keys.
  // Same AES-256-GCM primitive as Session.refreshTokenHash et al.
  idpCertificateEnc String   @map("idp_certificate_enc")
  // SP entity ID — usually https://your-domain/api/v1/sso/:tenantSlug/metadata
  spEntityId        String   @map("sp_entity_id")
  // Optional: sign AuthnRequests with SP private key (encrypted)
  spPrivateKeyEnc   String?  @map("sp_private_key_enc")
  // SAML attribute names that map to our user fields
  attrEmail         String   @default("email") @map("attr_email")
  attrFirstName     String   @default("firstName") @map("attr_first_name")
  attrLastName      String   @default("lastName") @map("attr_last_name")
  // Optional attribute that maps to UserRole enum value
  attrRole          String?  @map("attr_role")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("sso_configs")
}

