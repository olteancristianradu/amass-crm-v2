  INVITED
  REGISTERED
  ATTENDED
  CANCELLED
}

model Event {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  name        String
  description String?
  kind        EventKind       @default(CONFERENCE)
  startAt     DateTime        @map("start_at")
  endAt       DateTime        @map("end_at")
  location    String?
  capacity    Int?
  createdById String?         @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")
  attendees   EventAttendee[]

  @@index([tenantId, startAt])
  @@index([tenantId, deletedAt])
  @@map("events")
}

model EventAttendee {
  id           String              @id @default(cuid())
  // P0-3: tenantId for RLS coverage.
  tenantId     String              @map("tenant_id")
  eventId      String              @map("event_id")
  contactId    String?             @map("contact_id")
  clientId     String?             @map("client_id")
  email        String?
  fullName     String?             @map("full_name")
  status       EventAttendeeStatus @default(INVITED)
  registeredAt DateTime?           @map("registered_at")
  attendedAt   DateTime?           @map("attended_at")
  event        Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact      Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  client       Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([tenantId])
  @@map("event_attendees")
}

// ─── Saved views ──────────────────────────────────────────────────────────────
// Per-user, per-resource snapshot of a list page's filters/search/sort. The
// user names a view ("My Romanian SMBs") and the FE re-applies its `filters`
// blob when the view is selected. Scoped to a single resource so the FE can
// dropdown-list only the views that match the page it's on.
model SavedView {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  ownerId   String   @map("owner_id")
  resource  String
  name      String
  filters   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, resource, name])
  @@index([tenantId, ownerId, resource])
  @@map("saved_views")
}

// ─── GDPR consent tracking ───────────────────────────────────────────────────
// Records granular per-data-subject consents per processing purpose. Required
// for GDPR Art. 7 (provable consent — when, how, what, by whom) and Art. 6
// (lawful basis tracking).
//
// Append-only via service layer — revocation creates a NEW row with status=
// REVOKED rather than mutating existing. This preserves audit trail for
// regulators (ANSPDCP, supervisors) and survives data-subject access requests.
//
// Polymorphic subject via (subjectType, subjectId) matches repo convention
// (Note, Reminder, Attachment, AuditLog). For consent tracking we use CONTACT
// and CLIENT (data subjects = natural persons); COMPANY is not a data subject
// under GDPR (entities don't have GDPR rights, only natural persons do).

model ConsentRecord {
  id          String         @id @default(cuid())
  tenantId    String
  subjectType SubjectType
  subjectId   String
  purpose     ConsentPurpose
  lawfulBasis LawfulBasis
  status      ConsentStatus
  grantedAt   DateTime?
  revokedAt   DateTime?
  // Provenance — required for GDPR Art. 7(1) "controller shall be able to
  // demonstrate that the data subject has consented".
  source      String? // e.g. "signup_form", "checkbox_email_marketing", "verbal_call"
  ipAddress   String?
  userAgent   String?
  // Arbitrary supporting evidence: form snapshot, call recording ref, etc.
  evidence    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, purpose, status])
  @@index([tenantId, createdAt])
  @@map("consent_records")
}

/// GDPR Art. 6(1) lawful bases for processing personal data.
enum LawfulBasis {
  CONSENT // Art. 6(1)(a) — explicit consent from data subject
  CONTRACT // Art. 6(1)(b) — necessary for contract performance with subject
  LEGAL_OBLIGATION // Art. 6(1)(c) — controller's legal compliance requirement
  VITAL_INTEREST // Art. 6(1)(d) — protecting vital interests of subject or another
  PUBLIC_TASK // Art. 6(1)(e) — task carried out in public interest
  LEGITIMATE_INTEREST // Art. 6(1)(f) — legitimate business interest balanced vs subject rights
}

/// Specific data-processing purposes a subject may consent to or revoke.
/// Granular by design — single global consent doesn't satisfy GDPR Art. 7(2).
enum ConsentPurpose {
  MARKETING_EMAIL
  MARKETING_SMS
  MARKETING_WHATSAPP
  CALL_RECORDING
  CALL_TRANSCRIPTION
  AI_PROFILING
  AI_LEAD_SCORING
  COOKIES_FUNCTIONAL
  COOKIES_ANALYTICS
  COOKIES_MARKETING
  DATA_SHARING_PARTNERS
  NEWSLETTER
}

/// Current state of a consent record. Revocation = new row with status=REVOKED,
/// not UPDATE on existing — preserves provable history.
enum ConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
  PENDING
}

// ─── Tags ─────────────────────────────────────────────────────────────────────
/// Freeform labels tenants apply to any CRM entity for rapid segmentation.
/// E.g. "are pompă căldură Aer-Apă", "consum 1000-2000 lei/lună".

model Tag {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  color     String? // hex or tailwind color token
  createdAt DateTime @default(now()) @map("created_at")

  entityTags EntityTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

/// Polymorphic junction — tag applied to an entity.
/// entityType: COMPANY | CONTACT | CLIENT | DEAL | LEAD
model EntityTag {
  id         String @id @default(cuid())
  tenantId   String @map("tenant_id")
  tagId      String @map("tag_id")
  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, entityId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, tagId])
  @@map("entity_tags")
}

// ─── Outlook Email Integration ────────────────────────────────────────────────
/// Per-user Outlook OAuth token for reading + sending email via Microsoft Graph.
/// Scopes requested: openid email profile offline_access Mail.ReadWrite Mail.Send
/// Separate from CalendarIntegration (which only has Calendars.ReadWrite scope).

model OutlookToken {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  userId          String   @map("user_id")
  email           String // the connected Outlook email address
  displayName     String?  @map("display_name")
  accessTokenEnc  String   @map("access_token_enc")
  refreshTokenEnc String   @map("refresh_token_enc")
  tokenExpiresAt  DateTime @map("token_expires_at")
  // Inbox delta link from Graph /me/mailFolders/inbox/messages/delta — used for
  // incremental sync so we don't re-fetch the entire inbox on every sync call.
  inboxDeltaLink  String?  @map("inbox_delta_link")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("outlook_tokens")
}

// ─── Pro Cockpit ──────────────────────────────────────────────────────────────
/// Per-user widget layout for the Pro Cockpit page (`/app/cockpit`). Stores
/// the ordered list of enabled widgets so the layout follows the user across
/// devices. Falls back to localStorage on the FE if the API is unreachable.
model CockpitLayout {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  /// Ordered list of widget ids: ["deals-in-danger","reminders-due-today",...]
  /// Stored as JSON to keep order without an extra junction table.
  widgets   Json
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("cockpit_layouts")
}

// ─── Phase 0 / Migration B — Multi-currency (GLOBAL, NOT tenant-scoped) ──────
// IMPORTANT: ExchangeRate is GLOBAL by design — ECB EUR/X daily rates are the
// same for all tenants. Do NOT add it to TENANT_SCOPED_MODELS in
// apps/api/src/infra/prisma/prisma.service.ts. Doing so would make every
// query inject a `tenantId` filter that doesn't match any column → Prisma
// error P2009. Writes are restricted at the DB layer: the migration REVOKEs
// INSERT/UPDATE/DELETE from `app_user`, so only the BullMQ cron worker
// (running as the migration owner role) can refresh rates.

/// Source of an FX rate row. ECB is the primary feed (free, daily, EUR-based).
/// FIXER is a paid fallback for hourly/non-EUR pairs. MANUAL is an admin
/// override that is logged in the audit trail.
enum FxRateSource {
  ECB
  FIXER
  MANUAL
}

/// Daily FX rates fetched from ECB by a BullMQ cron job (06:00 RO every day,
/// jobId: `fx-daily-${YYYYMMDD}` so retries don't double-insert — T-FX-T-04).
/// GLOBAL — not tenant-scoped. All tenants read the same rates. Writes
/// restricted to a system role by REVOKE in the migration; `app_user` has
/// SELECT only (T-FX-T-02).
///
/// Storage shape: one row per (fromCurrency, toCurrency, asOf). For ECB the
/// base is EUR, so RON→USD = (1 / EUR_RON) * EUR_USD; we materialize both
/// directions so the lookup query is a single index probe.
model ExchangeRate {
  id           String       @id @default(cuid())
  fromCurrency String       @map("from_currency") @db.VarChar(3)
  toCurrency   String       @map("to_currency") @db.VarChar(3)
  rate         Decimal      @db.Decimal(18, 8)
  asOf         DateTime     @map("as_of") @db.Date
  source       FxRateSource @default(ECB)
  fetchedAt    DateTime     @default(now()) @map("fetched_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@unique([fromCurrency, toCurrency, asOf], map: "exchange_rates_pair_date_unique")
  @@index([asOf(sort: Desc)], map: "exchange_rates_as_of_desc_idx")
  @@map("exchange_rates")
}
