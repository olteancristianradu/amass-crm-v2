// AMASS-CRM v2 — Prisma schema
// Sprint 1: Tenant, User, Session (auth foundation)
// RLS policies + audit + RBAC arrive in Sprint 2.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), pg_trgm]
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
  VIEWER
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // G-prep: stable shard key precomputed once so the app can be migrated to a
  // sharded Postgres (Citus/Vitess) without rewriting every query. Until the
  // sharding threshold is crossed (see CLAUDE.md), this is purely advisory.
  shardId            Int?
  // E-compliance: SIEM webhook for audit log forwarding. NULL = use global
  // SIEM_WEBHOOK_URL fallback. Only populated for tenants with own collector.
  siemWebhookUrl     String?
  // E-compliance: tenant-specific retention override (days). NULL = use
  // AUDIT_RETENTION_DAYS_DEFAULT.
  auditRetentionDays Int?

  // F1.9: Onboarding state. NULL = wizard not yet completed (FE redirects
  // OWNER to /welcome). Set to a timestamp when OWNER finishes the wizard.
  onboardingCompletedAt DateTime?
  // F1.9: marked once tenant has loaded sample data via the welcome wizard
  // step 4. Prevents double-loading sample data and is shown in admin UI.
  sampleDataLoadedAt    DateTime?

  // F2-residency: data-residency region. Default 'EU' (Frankfurt/Amsterdam
  // via Railway). Enterprise tier can request 'EU-RO' (Romanian DC) or
  // 'EU-DE'. NULL = same as 'EU' (legacy tenants pre-residency-feature).
  // Read by services that route data to region-specific sub-processors.
  region String? @default("EU")

  // Script-compliance: per-tenant default list of points the agent should
  // hit on a sales/support call. AI worker uses this when evaluating a
  // call recording. NULL = feature disabled for the tenant.
  // Shape: string[] (e.g. ["a întrebat bugetul", "a oferit garanția 12 luni"])
  defaultCallScript Json?

  // Phase 0 / Migration B — multi-currency base. ISO 4217 code that the
  // tenant uses as its reporting currency. All `Deal.amountBase` figures
  // are denominated in this currency. Default 'RON' for the RO/EU SMB
  // baseline; admin can switch in tenant settings.
  baseCurrency String @default("RON") @map("base_currency")

  // Phase 0 / Migration A — i18n. Fallback locale served when a user has no
  // `preferredLocale` set. Short code ('ro'|'en') validated by Zod at the
  // service layer (`packages/shared/src/i18n/locale.schema.ts`). String not
  // enum to keep ALTER TYPE pain off the table when 'de'/'hu' arrive.
  defaultLocale String @default("ro") @map("default_locale")

  // Phase 0 / Migration A — i18n. Subset of supported locales the tenant
  // allows. Catalog is shipped as static JSON in `apps/web/src/i18n/`;
  // this list bounds what the FE language switcher offers. Default ['ro','en']
  // matches the Phase 0 catalog ship list (`docs/ROADMAP_V2.md:75`).
  enabledLocales String[] @default(["ro", "en"]) @map("enabled_locales")

  // Sec-kill-switch (BLUE2#3): incident response can flip this to false to
  // freeze all access for a compromised tenant without deleting data. Checked
  // by JwtAuthGuard / TenantContextMiddleware on every authed request.
  // suspendedAt records when (audit) and suspendedReason captures why.
  isActive        Boolean   @default(true)
  suspendedAt     DateTime?
  suspendedReason String?

  // Phase 1 / F1 — GDPR opt-out at tenant level. Disables tracking pixel +
  // click-rewrite injection in EmailService for ALL outbound emails from this
  // tenant. Defaults true (backward-compat with pre-Phase-1 sends); tenant
  // admin can flip to false to comply with Art. 6 lawful-basis if the tenant
  // chooses NOT to rely on legitimate-interest balancing for tracking.
  // Per docs/threat-models/phase-1.md T-MAIL-E-02.
  emailTrackingEnabled Boolean @default(true) @map("email_tracking_enabled")

  users      User[]
  passkeys   Passkey[]
  scimTokens ScimToken[]

  @@index([shardId])
  @@index([region])
  @@map("tenants")
}

/**
 * B3-PR3: SCIM bearer-token. One row per IdP integration (e.g. "Okta production"
 * and "Okta staging" are two separate tokens, both scoped to the same tenant).
 * Storage model is the same as PasswordResetToken / EmailVerificationToken:
 * we persist a SHA-256 hash of the raw token so a DB dump does not leak
 * working credentials. The raw token is shown to the operator EXACTLY ONCE
 * at create time (GitHub PAT pattern) — `scim-token.service.ts#create`
 * returns it, then we never see it again.
 * `lastUsedAt` is bumped on every successful verify so admins can detect
 * abandoned integrations. `revokedAt` is set by `revoke()` and never cleared;
 * the verify path filters by `revokedAt IS NULL` so revocation is permanent.
 */
model ScimToken {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("scim_tokens")
}

model User {
  id              String    @id @default(cuid())
  tenantId        String
  email           String
  emailVerifiedAt DateTime? @map("email_verified_at")
  passwordHash    String
  fullName        String
  role            UserRole  @default(AGENT)
  isActive        Boolean   @default(true)
  // TOTP two-factor authentication. Secret is stored encrypted via ENCRYPTION_KEY.
  // totpEnabled gates the TOTP check in the login flow.
  totpSecret      String?   @map("totp_secret")
  totpEnabled     Boolean   @default(false) @map("totp_enabled")
  // Hashed TOTP backup codes — JSON array of SHA-256 hex digests. Each
  // code is single-use: on successful TOTP backup-login we splice it
  // out of the array. Raw codes are shown to the user ONCE at enrol time.
  totpBackupCodes Json?     @map("totp_backup_codes")
  // F1.12: per-user product tour completion log. JSON array of tour IDs the
  // user has completed (or explicitly dismissed). FE checks this before
  // auto-launching a tour to avoid annoying repeat-visitors. Persisted in DB
  // (not localStorage) so the experience is consistent across devices/browsers.
  completedTours  Json      @default("[]")
  // Phase 0 / Migration A — i18n. Per-user locale override. Short code
  // ('ro'|'en'). NOT NULL with default so existing rows backfill atomically
  // at ALTER TABLE; service-layer Zod whitelists value against
  // `tenant.enabledLocales` and falls back to `tenant.defaultLocale` if
  // the user's choice was revoked by an admin.
  preferredLocale String    @default("ro") @map("preferred_locale")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  passkeys                Passkey[]
  // Back-relations from business_fk_constraints + saved_views migrations.
  ownedDeals              Deal[]                   @relation("DealOwner")
  assignedTasks           Task[]                   @relation("TaskAssignee")
  assignedCases           Case[]                   @relation("CaseAssignee")
  ownedLeads              Lead[]                   @relation("LeadOwner")
  savedViews              SavedView[]

  // Email is unique within a tenant, not globally — multi-tenant requirement.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/**
 * Password reset tokens — one-time bearer tokens mailed to the user.
 * Token is stored as SHA-256 hash so a DB dump does not let an attacker
 * reset anyone's password. `used=true` is set on successful consumption
 * and never un-set. Row TTL is via `expiresAt`; a cron prunes expired.
 */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/**
 * Email verification tokens. Issued at register() and on email change.
 * Same hash + TTL + single-use semantics as password reset.
 */
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/**
 * B2: WebAuthn / FIDO2 passkey credentials. One row per registered authenticator
 * (a single user can have many — phone, laptop, hardware key). Public key + counter
 * are persisted; the private key never leaves the user's device.
 * Tenant-scoped: a passkey belongs to a (tenant, user) tuple. RLS + tenantExtension
 * filter listings by tenantId so a cross-tenant join cannot enumerate another
 * tenant's authenticators. Credential IDs are globally unique (the WebAuthn spec
 * guarantees this), which keeps the assertion lookup at login a single index probe.
 */
model Passkey {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceName   String?   @map("device_name")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime? @map("last_used_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("passkeys")
}

enum ImportType {
  CLIENTS
  COMPANIES
  CONTACTS
}

enum ImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ImportJob {
  id          String       @id @default(cuid())
  tenantId    String
  type        ImportType
  status      ImportStatus @default(PENDING)
  fileName    String
  storageKey  String // MinIO object key — `<tenantId>/imports/<uuid>-<fileName>`
  totalRows   Int          @default(0)
  processed   Int          @default(0)
  succeeded   Int          @default(0)
  failed      Int          @default(0)
  skipped     Int          @default(0)
  errors      Json? // array of {row, message}
  createdById String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("import_jobs")
}

enum CompanySize {
  MICRO // 1-9
  SMALL // 10-49
  MEDIUM // 50-249
  LARGE // 250+
}

/// CRM relationship lifecycle stage for a company.
enum RelationshipStatus {
  LEAD
  PROSPECT
  ACTIVE
  INACTIVE
}

/// How this company/lead was acquired.
enum LeadSource {
  REFERRAL
  WEB
  COLD_CALL
  EVENT
  PARTNER
  SOCIAL
  OTHER
}

model Company {
  id                 String                       @id @default(cuid())
  tenantId           String
  name               String
  vatNumber          String? // CUI for Romanian companies
  registrationNumber String? // J-number
  industry           String?
  size               CompanySize?
  relationshipStatus RelationshipStatus?          @map("relationship_status")
  leadSource         LeadSource?                  @map("lead_source")
  website            String?
  email              String?
  phone              String?
  addressLine        String?
  city               String?
  county             String?
  postalCode         String?
  country            String?                      @default("RO")
  notes              String?
  createdById        String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  deletedAt          DateTime?
  /// Populated asynchronously by EmbeddingService (OpenAI text-embedding-3-small).
  /// Not accessible via normal Prisma client — use $queryRaw for vector ops.
  embedding          Unsupported("vector(1536)")?
  parentId           String?                      @map("parent_id")
  // When a parent company is deleted, subsidiaries become root-level (no cascade) —
  // safer than cascading since we also don't want to lose their data.
  parent             Company?                     @relation("CompanyHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subsidiaries       Company[]                    @relation("CompanyHierarchy")

  contacts               Contact[]
  quotes                 Quote[]
  // Back-relations matching FKs added in business_fk_constraints migrations.
  deals                  Deal[]
  invoices               Invoice[]
  cases                  Case[]
  contracts              Contract[]
  customer_subscriptions CustomerSubscription[]
  orders                 Order[]
  portal_tokens          PortalToken[]
  projects               Project[]

  @@index([tenantId, createdAt])
  @@index([tenantId, name])
  @@index([tenantId, vatNumber])
  @@index([tenantId, relationshipStatus])
  @@index([parentId])
  @@index([tenantId, deletedAt])
  @@map("companies")
}

model Contact {
  id          String                       @id @default(cuid())
  tenantId    String
  companyId   String?
  firstName   String
  lastName    String
  jobTitle    String?
  email       String?
  phone       String?
  mobile      String?
  isDecider   Boolean                      @default(false) @map("is_decider")
  notes       String?
  createdById String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  deletedAt   DateTime?
  /// See Company.embedding note above.
  embedding   Unsupported("vector(1536)")?

  company              Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Back-relations from business_fk_constraints migrations.
  deals                Deal[]
  cases                Case[]
  event_attendees      EventAttendee[]
  sequence_enrollments SequenceEnrollment[]
  sms_messages         SmsMessage[]

  @@index([tenantId, createdAt])
  @@index([tenantId, companyId])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, deletedAt])
  // P1-6: prevent duplicate contact records sharing the same email per
  // tenant. Postgres treats multiple NULLs as distinct, so contacts without
  // an email address can coexist; only non-null emails are deduped.
  @@index([tenantId, email])
  @@map("contacts")
}

model Client {
  id          String                       @id @default(cuid())
  tenantId    String
  firstName   String
  lastName    String
  email       String?
  phone       String?
  mobile      String?
  addressLine String?
  city        String?
  county      String?
  postalCode  String?
  country     String?                      @default("RO")
  notes       String?
  createdById String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  deletedAt   DateTime?
  /// See Company.embedding note above.
  embedding   Unsupported("vector(1536)")?

  // Back-relations from business_fk_constraints migrations.
  event_attendees EventAttendee[]
  portal_tokens   PortalToken[]

  @@index([tenantId, createdAt])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, email])
  @@index([tenantId, deletedAt])
  @@map("clients")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorId     String?
  action      String // e.g. "user.create", "auth.login", "company.delete"
  subjectType String? // e.g. "user", "company"
  subjectId   String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, subjectType, subjectId])
  @@map("audit_logs")
}

/// Polymorphic subject types — every notes/activities/attachments row
/// references one of these via (subjectType, subjectId). Keep in sync with
/// SubjectTypeSchema in @amass/shared.
enum SubjectType {
  COMPANY
  CONTACT
  CLIENT
}

model Attachment {
  id           String      @id @default(cuid())
  tenantId     String
  subjectType  SubjectType
  subjectId    String
  storageKey   String      @unique // path inside the MinIO bucket
  fileName     String
  mimeType     String
  size         Int
  uploadedById String?
  createdAt    DateTime    @default(now())
  deletedAt    DateTime?

  // Versioning — parentId points to the root (v1). version starts at 1
  // and increments for each new version. isLatest is denormalised for
  // cheap filtering in the list endpoint.
  parentId String?      @map("parent_id")
  version  Int          @default(1)
  isLatest Boolean      @default(true) @map("is_latest")
  // When the v1 parent is deleted, its versions also go — keeps file metadata
  // consistent with MinIO cleanup downstream.
  parent   Attachment?  @relation("AttachmentVersions", fields: [parentId], references: [id], onDelete: Cascade)
  versions Attachment[] @relation("AttachmentVersions")

  @@index([tenantId, subjectType, subjectId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, parentId])
  @@index([tenantId, deletedAt])
  @@map("attachments")
}

model Note {
  id          String      @id @default(cuid())
  tenantId    String
  subjectType SubjectType
  subjectId   String
  /// Cap notes at 10_000 chars. Anything longer belongs in an attachment.
  body        String      @db.VarChar(10000)
  authorId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@index([tenantId, subjectType, subjectId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@map("notes")
}

/// Polymorphic reminder. Created by a user, attached to any subject
/// (Company / Contact / Client today). A BullMQ delayed job is enqueued
/// at create time with `jobId = reminder.id` for idempotency. When the
/// delayed job fires, the processor flips status to FIRED and writes an
/// activity row. Snooze = cancel old job + re-enqueue at the new time;
/// dismiss/delete = cancel job. The job and the row are kept in sync via
/// the row id == BullMQ jobId convention.
enum ReminderStatus {
  PENDING
  FIRED
  DISMISSED
  CANCELLED
}

model Reminder {
  id          String         @id @default(cuid())
  tenantId    String
  subjectType SubjectType
  subjectId   String
  actorId     String? // who created the reminder (null if system)
  title       String
  body        String?
  remindAt    DateTime
  status      ReminderStatus @default(PENDING)
  firedAt     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([tenantId, subjectType, subjectId, remindAt])
  @@index([tenantId, actorId, status, remindAt])
  @@index([tenantId, status, remindAt])
  @@index([tenantId, deletedAt])
  @@map("reminders")
}

/// Domain-level activity log (NOT the audit_logs table). Activities are
/// what shows up in the UI timeline: "Andrei created this company",
/// "Maria added a note", "Status changed to WON". Audit_logs are
/// security-level and stay separate.
model Activity {
  id          String      @id @default(cuid())
  tenantId    String
  subjectType SubjectType
  subjectId   String
  actorId     String?
  action      String // e.g. "company.created", "note.added", "company.updated"
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([tenantId, subjectType, subjectId, createdAt])
  @@index([tenantId, createdAt])
  @@map("activities")
}

/// Sprint 10 — Pipelines, Deals, Tasks.
///
/// Pipelines define the sales funnel. Each tenant can have multiple
/// pipelines (e.g. "Vânzări B2B" vs "Clienți retail"), and exactly one is
/// marked `isDefault = true`. A pipeline owns an ordered list of Stages,
/// each with a type (OPEN, WON or LOST) and an implicit win probability.
/// Deals belong to exactly one (pipeline, stage) pair at a time.
///
/// On tenant register, the AuthService seeds a default pipeline with
/// four stages (New, Qualified, Negotiation, Won + Lost) so the FE has
/// something to render immediately.
model Pipeline {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isDefault   Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  stages PipelineStage[]
  deals  Deal[]

  @@index([tenantId, order])
  @@index([tenantId, isDefault])
  @@index([tenantId, deletedAt])
  @@map("pipelines")
}

enum StageType {
  OPEN
  WON
  LOST
}

model PipelineStage {
  id          String    @id @default(cuid())
  tenantId    String
  pipelineId  String
  name        String
  type        StageType @default(OPEN)
  order       Int       @default(0)
  probability Int       @default(0) // 0..100, purely informational
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([tenantId, pipelineId, order])
  @@index([tenantId, deletedAt])
  @@map("pipeline_stages")
}

enum DealStatus {
  OPEN
  WON
  LOST
}

/// A Deal is the unit of work on the Kanban. It is linked to (optionally)
/// a company and/or a contact, and always to a (pipeline, stage) pair.
/// `orderInStage` lets us preserve a manual ordering within a column —
/// new deals are appended (max+1), moves set an explicit value, and the
/// service keeps gaps rather than re-packing (cheaper + fewer write locks).
/// `status` is derived from the stage's type at move time, so the FE can
/// filter "open deals" without joining the stages table.
model Deal {
  id              String     @id @default(cuid())
  tenantId        String
  pipelineId      String
  stageId         String
  companyId       String?
  contactId       String?
  ownerId         String? // which user owns the deal
  title           String
  description     String?
  value           Decimal?   @db.Decimal(14, 2)
  currency        String     @default("RON")
  // Phase 0 / Migration B — multi-currency. Denormalized `value` converted to
  // tenant's base currency at `fxRateAt`. Server-computed only (DTO `.strict()`
  // rejects client value, see threat T-FX-T-02). NULL = not yet computed
  // (e.g. non-RON deal awaiting first ECB load); reports surface the gap as
  // "+ N deals în alte valute (necalculate)" rather than silently dropping.
  // Precision aligned with `value` (14,2) to avoid atomic-bump risk.
  amountBase      Decimal?   @map("amount_base") @db.Decimal(14, 2)
  // Phase 0 / Migration B — snapshot of the FX date used to compute
  // `amountBase`. Lets historical reports stay reproducible across rate
  // updates; recompute job uses `asOf <= deal.updatedAt` guard (T-FX-T-03).
  fxRateAt        DateTime?  @map("fx_rate_at") @db.Date
  probability     Int? // override of stage.probability (nullable → inherit)
  expectedCloseAt DateTime?
  status          DealStatus @default(OPEN)
  lostReason      String?
  closedAt        DateTime?
  orderInStage    Int        @default(0)
  createdById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  pipeline Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage    PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  // FK relations declared in migration 20260428130000 / 140000 — must be
  // mirrored here to keep `prisma migrate diff` (CI) clean.
  company  Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact  Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner    User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks    Task[]
  invoices Invoice[]
  projects Project[]
  quotes   Quote[]

  @@index([tenantId, pipelineId, stageId, orderInStage])
  @@index([tenantId, status])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, companyId])
  @@index([tenantId, contactId])
  @@index([tenantId, expectedCloseAt])
  @@index([tenantId, deletedAt])
  @@map("deals")
}

enum TaskStatus {
  OPEN
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

/// A Task can hang off a Deal OR a polymorphic subject (Company/Contact/
/// Client). Exactly one of (dealId) or (subjectType + subjectId) is
/// populated — the service asserts this. Tasks join the polymorphic
/// SubjectType family along with Notes/Attachments/Reminders.
model Task {
  id          String       @id @default(cuid())
  tenantId    String
  dealId      String?
  subjectType SubjectType?
  subjectId   String?
  assigneeId  String? // user who must complete it
  title       String
  description String?
  dueAt       DateTime?
  status      TaskStatus   @default(OPEN)
  priority    TaskPriority @default(NORMAL)
  completedAt DateTime?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  deal     Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([tenantId, assigneeId, status, dueAt])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, dealId])
  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, deletedAt])
  @@map("tasks")
}

/// Sprint 11 — Email integration (send-only MVP).
///
/// EmailAccount stores per-user SMTP credentials. The password is encrypted
/// at rest using AES-256-GCM with a server-side ENCRYPTION_KEY (env var).
/// Each user can have multiple accounts but exactly one marked `isDefault`.
/// The fromEmail is what appears in the From header; smtpUser is the login.
model EmailAccount {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String // the user who owns this account
  label       String // friendly name, e.g. "Gmail profesional"
  smtpHost    String
  smtpPort    Int       @default(587)
  smtpSecure  Boolean   @default(false) // true = implicit TLS (port 465)
  smtpUser    String
  smtpPassEnc String // AES-256-GCM encrypted password (base64)
  fromName    String
  fromEmail   String
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  messages EmailMessage[]

  @@index([tenantId, userId])
  @@index([tenantId, userId, isDefault])
  @@index([tenantId, deletedAt])
  @@map("email_accounts")
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

/// EmailMessage tracks every email sent from the CRM. Linked to a polymorphic
/// subject (Company/Contact/Client) so sent emails appear on the timeline.
/// Sending is async: the controller creates a QUEUED row + enqueues a BullMQ
/// job; the processor sends via Nodemailer and flips status to SENT or FAILED.
model EmailMessage {
  id           String      @id @default(cuid())
  tenantId     String
  accountId    String
  subjectType  SubjectType
  subjectId    String
  toAddresses  String[] // array of email addresses
  ccAddresses  String[]    @default([])
  bccAddresses String[]    @default([])
  subject      String      @db.VarChar(998)
  /// RFC 5322 soft-limit 998 chars/line; hard-cap HTML at 1 MiB to prevent
  /// oversized row writes and reduce DB replication pressure.
  bodyHtml     String      @db.VarChar(1048576)
  bodyText     String?     @db.VarChar(262144) // plain-text fallback, 256 KiB
  status       EmailStatus @default(QUEUED)
  sentAt       DateTime?
  errorMessage String?
  messageId    String? // SMTP Message-ID header after sending
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  account EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tracks  EmailTrack[]

  @@index([tenantId, subjectType, subjectId, createdAt])
  @@index([tenantId, accountId, status])
  @@index([tenantId, createdById, createdAt])
  @@index([tenantId, status])
  @@map("email_messages")
}

enum EmailTrackKind {
  OPEN
  CLICK
  // Phase 1 — deliverability events from provider webhooks + per-recipient
  // tracking. BOUNCE/SPAM_REPORT may have NULL message_id (provider hook-back
  // arrives before EmailMessage match) but MUST have recipient_id.
  BOUNCE
  UNSUBSCRIBE
  SPAM_REPORT
  DELIVERED
}

/// Tracks opens (tracking pixel hit) + clicks (redirect endpoint) for
/// outbound emails. Phase 0: one row per event keyed by messageId.
/// Phase 1: row may attribute to a CampaignRecipient (recipient_id) instead
/// of or in addition to a message — provider hook-back events (BOUNCE,
/// SPAM_REPORT) often arrive before we've matched them to an EmailMessage.
/// CHECK constraint (in SQL migration): message_id IS NOT NULL OR
/// recipient_id IS NOT NULL — orphaned rows rejected at DB layer.
model EmailTrack {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  // Phase 1: NULLABLE (was NOT NULL pre-Phase 1). Either message_id or
  // recipient_id MUST be set — see CHECK email_tracks_attribution_chk.
  messageId   String?        @map("message_id")
  recipientId String?        @map("recipient_id")
  kind        EmailTrackKind
  url         String? // present for CLICK, null for OPEN
  ipAddress   String?        @map("ip_address")
  userAgent   String?        @map("user_agent")
  // Phase 1 — bounce diagnostics from SMTP/provider hook-backs
  bounceType  String?        @map("bounce_type") @db.VarChar(32)
  bounceCode  String?        @map("bounce_code") @db.VarChar(64)
  // Phase 1 — GDPR anonymization clock. NULL = still has raw PII;
  // non-NULL = ip_address + user_agent have been nullified by daily cron.
  piiHashedAt DateTime?      @map("pii_hashed_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  message   EmailMessage?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient CampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([tenantId, messageId, createdAt])
  @@index([tenantId, kind, createdAt])
  // Phase 1 — per-recipient timeline lookup (partial WHERE recipient_id IS
  // NOT NULL is created hand-rolled in the SQL migration; Prisma's @@index
  // can't express partial filters).
  @@index([tenantId, recipientId, createdAt])
  @@map("email_tracks")
}

// ─── Phase 1 — EmailSuppression (GDPR hash-based unsub/bounce list) ──────

enum EmailSuppressionReason {
  USER_UNSUBSCRIBE
  BOUNCE_HARD
  SPAM_REPORT
  MANUAL_ADD
  COMPLAINT
  GLOBAL_BLOCK
}

/// Persistent unsubscribe / hard-bounce / spam list. Stored as SHA-256 hash
/// of lowercased email (no plaintext PII) so we satisfy BOTH GDPR Art. 17
/// (right to erasure of the contact) AND CAN-SPAM §5(a)(4) (must not
/// re-contact after unsubscribe). Pre-send check is a single lookup on
/// (tenant_id, email_hash). emailMasked gives admin UI a non-PII rendering.
model EmailSuppression {
  id          String                 @id @default(cuid())
  tenantId    String                 @map("tenant_id")
  /// SHA-256 hex of lowercase(trim(email)). 64 hex chars, app computes.
  emailHash   String                 @map("email_hash") @db.Char(64)
  /// Masked rendering for admin UI (e.g., "j****@e****.com"). App enforces
  /// the masking rule; DB just stores the chosen string.
  emailMasked String                 @map("email_masked") @db.VarChar(320)
  reason      EmailSuppressionReason
  /// Free-form provenance hint ("webhook:mailgun", "user:abc", "import:csv").
  source      String?                @db.VarChar(128)
  addedAt     DateTime               @default(now()) @map("added_at")
  /// Optional auto-expiry. NULL = indefinite (default for USER_UNSUBSCRIBE
  /// and BOUNCE_HARD); MANUAL_ADD may have a TTL set by the admin.
  expiresAt   DateTime?              @map("expires_at")
  addedById   String?                @map("added_by_id")
  notes       String?                @db.VarChar(1024)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  @@unique([tenantId, emailHash], map: "email_suppressions_tenant_email_hash_uniq")
  @@index([tenantId, reason, addedAt(sort: Desc)], map: "email_suppressions_tenant_reason_added_idx")
  // Phase 1 — partial index "email_suppressions_expiry_idx" on
  // (expires_at) WHERE expires_at IS NOT NULL is created hand-rolled in SQL.
  @@map("email_suppressions")
}

/// Sprint 12 — Calls (Twilio).
///
/// Phone numbers purchased via Twilio and assigned to users. Each user can
/// have exactly one default number. Outbound calls use the caller's default
/// (or explicit) number as the From. Inbound calls are routed via webhooks
/// based on the To number.
model PhoneNumber {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String? // null = tenant-level, used by everyone
  twilioSid String    @unique
  number    String    @unique // E.164: +40712345678 — globally unique: one number can only belong to one tenant
  label     String?
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  calls Call[]

  @@index([tenantId, userId])
  @@index([tenantId, number])
  @@index([tenantId, deletedAt])
  @@map("phone_numbers")
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED // just initiated via API, not yet dialled
  RINGING // Twilio is dialling
  IN_PROGRESS // call answered
  COMPLETED // ended normally
  BUSY
  NO_ANSWER
  FAILED
  CANCELED
}

enum TranscriptionStatus {
  NONE // no recording / not applicable
  PENDING // recording available, waiting for AI worker
  IN_PROGRESS // AI worker is processing
  COMPLETED
  FAILED
}

/// A Call row is the canonical record of a phone call — created either
/// when the user clicks "call" in the CRM (outbound) or when Twilio posts
/// an inbound webhook. Linked polymorphically to a subject (Company /
/// Contact / Client) so calls appear in the timeline.
///
/// The recording lives in MinIO after download (bucket key = storage_key).
/// Transcript + summary are populated by the S13 AI worker asynchronously.
model Call {
  id                  String              @id @default(cuid())
  tenantId            String
  subjectType         SubjectType
  subjectId           String
  phoneNumberId       String? // our side of the call
  userId              String? // which user initiated/received
  twilioCallSid       String?             @unique
  direction           CallDirection
  status              CallStatus          @default(QUEUED)
  fromNumber          String
  toNumber            String
  startedAt           DateTime?
  answeredAt          DateTime?
  endedAt             DateTime?
  durationSec         Int?
  recordingSid        String?
  recordingUrl        String? // Twilio URL (signed, short-lived)
  recordingStorageKey String? // MinIO key after download
  transcriptionStatus TranscriptionStatus @default(NONE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  phoneNumber PhoneNumber?    @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  transcript  CallTranscript?

  @@index([tenantId, subjectType, subjectId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, transcriptionStatus])
  @@index([tenantId, deletedAt])
  @@map("calls")
}

/// Sprint 13 — AI worker output. A Call has at most one CallTranscript;
/// populated by the Python ai-worker after transcription + PII redaction
/// + summarisation. Keeping it in a separate table because the payload is
/// large (full transcript JSON with diarization) and we often read Call
/// rows without needing the transcript.
model CallTranscript {
  id                    String   @id @default(cuid())
  tenantId              String
  callId                String   @unique
  language              String? // ISO 639-1 detected by Whisper
  rawText               String // full transcript, concatenated
  segments              Json // array of { start, end, speaker, text }
  redactedText          String? // text after Presidio PII redaction
  summary               String? // short Claude-generated summary
  actionItems           Json? // array of extracted action items (strings)
  sentiment             String? // positive / neutral / negative
  topics                Json? // array of topics
  scriptComplianceScore Int? // 0–100: % of sales script covered
  scriptMissedItems     Json? // array of string — script points not covered
  processedAt           DateTime @default(now())
  model                 String? // which Claude model was used
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([tenantId, callId])
  @@map("call_transcripts")
}

/// Sprint 15 — Automated workflows/sequences.
///
/// A Workflow is a tenant-scoped automation: one trigger event starts an
/// ordered list of WorkflowSteps. A WorkflowRun tracks one execution of a
/// workflow for one subject (Deal / Contact / Company).
enum WorkflowTrigger {
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  CONTACT_CREATED
  COMPANY_CREATED
}

enum WorkflowActionType {
  SEND_EMAIL
  CREATE_TASK
  ADD_NOTE
  WAIT_DAYS
  SEND_CAMPAIGN
}

enum WorkflowRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Workflow {
  id            String          @id @default(cuid())
  tenantId      String          @map("tenant_id")
  name          String
  description   String?
  isActive      Boolean         @default(true) @map("is_active")
  trigger       WorkflowTrigger
  /// { stageId?: string } for DEAL_STAGE_CHANGED, {} for others
  triggerConfig Json            @default("{}") @map("trigger_config")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  steps WorkflowStep[]
  runs  WorkflowRun[]

  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
  @@map("workflows")
}

model WorkflowStep {
  id           String             @id @default(cuid())
  workflowId   String             @map("workflow_id")
  tenantId     String             @map("tenant_id")
  order        Int                @default(0)
  actionType   WorkflowActionType @map("action_type")
  /// SEND_EMAIL: { accountId, subject, body }
  /// CREATE_TASK: { title, priority, dueInDays }
  /// ADD_NOTE: { body }
  /// WAIT_DAYS: { days }
  actionConfig Json               @default("{}") @map("action_config")
  createdAt    DateTime           @default(now()) @map("created_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, order])
  @@map("workflow_steps")
}

model WorkflowRun {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  workflowId  String            @map("workflow_id")
  subjectType String            @map("subject_type") // 'DEAL' | 'CONTACT' | 'COMPANY'
  subjectId   String            @map("subject_id")
  status      WorkflowRunStatus @default(RUNNING)
  currentStep Int               @default(0) @map("current_step")
  startedAt   DateTime          @default(now()) @map("started_at")
  completedAt DateTime?         @map("completed_at")
  error       String?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId, workflowId, status])
  @@index([tenantId, subjectType, subjectId])
  @@map("workflow_runs")
}

// ─── S22 Invoices ────────────────────────────────────────────────────────────
// Facturi emise de către tenant către Company (clienți).
// Status transitions: DRAFT → ISSUED → (PARTIALLY_PAID|PAID|OVERDUE|CANCELLED).
// Numbering: (series, number) unique per tenant — standard RO invoice practice.

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceCurrency {
  RON
  EUR
  USD
}

model Invoice {
  id            String          @id @default(cuid())
  tenantId      String          @map("tenant_id")
  companyId     String          @map("company_id")
  dealId        String?         @map("deal_id")
  series        String
  number        Int
  issueDate     DateTime        @map("issue_date")
  dueDate       DateTime        @map("due_date")
  subtotal      Decimal         @db.Decimal(14, 2)
  vatAmount     Decimal         @default(0) @map("vat_amount") @db.Decimal(14, 2)
  total         Decimal         @db.Decimal(14, 2)
  currency      InvoiceCurrency @default(RON)
  status        InvoiceStatus   @default(DRAFT)
  notes         String?
  pdfStorageKey String?         @map("pdf_storage_key")
  createdById   String?         @map("created_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  lines            InvoiceLine[]
  payments         Payment[]
  // Forward + back FK relations from business_fk_constraints migrations.
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deal             Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  anaf_submissions AnafSubmission[]
  quotes           Quote[]

  @@unique([tenantId, series, number])
  @@index([tenantId, companyId, issueDate])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, deletedAt])
  @@map("invoices")
}

model InvoiceLine {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  invoiceId   String   @map("invoice_id")
  productId   String?  @map("product_id")
  position    Int
  description String   @db.VarChar(500)
  quantity    Decimal  @db.Decimal(14, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 2)
  vatRate     Decimal  @default(19) @map("vat_rate") @db.Decimal(5, 2)
  subtotal    Decimal  @db.Decimal(14, 2)
  vatAmount   Decimal  @map("vat_amount") @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// ─── S24 Payments (scaffold — used by Invoice status calc) ──────────────────

enum PaymentMethod {
  BANK
  CASH
  CARD
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  invoiceId   String        @map("invoice_id")
  amount      Decimal       @db.Decimal(14, 2)
  paidAt      DateTime      @map("paid_at")
  method      PaymentMethod @default(BANK)
  reference   String?
  notes       String?
  createdById String?       @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  deletedAt   DateTime?     @map("deleted_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@index([tenantId, paidAt])
  @@index([tenantId, deletedAt])
  @@map("payments")
}

// ─── S23 Projects ────────────────────────────────────────────────────────────
// A Project is created from a won Deal — groups invoices, tasks, attachments
// under one delivery umbrella.

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  companyId   String          @map("company_id")
  dealId      String?         @unique @map("deal_id")
  name        String
  description String?
  status      ProjectStatus   @default(PLANNED)
  startDate   DateTime?       @map("start_date")
  endDate     DateTime?       @map("end_date")
  budget      Decimal?        @db.Decimal(14, 2)
  currency    InvoiceCurrency @default(RON)
  createdById String?         @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deal    Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([tenantId, companyId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("projects")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  tenantId         String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── Quotes (oferte comerciale) ──────────────────────────────────────────────
// Separate from Invoices: Quote → (accepted) → Invoice conversion.
// Status flow: DRAFT → SENT → ACCEPTED | REJECTED | EXPIRED.

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  companyId   String          @map("company_id")
  dealId      String?         @map("deal_id")
  /// Human-readable number e.g. "OF-2024-001"
  number      String
  title       String
  issueDate   DateTime        @map("issue_date")
  validUntil  DateTime        @map("valid_until")
  subtotal    Decimal         @db.Decimal(14, 2)
  vatAmount   Decimal         @default(0) @map("vat_amount") @db.Decimal(14, 2)
  total       Decimal         @db.Decimal(14, 2)
  currency    InvoiceCurrency @default(RON)
  status      QuoteStatus     @default(DRAFT)
  notes       String?
  /// Set when the quote is converted to an invoice
  invoiceId   String?         @unique @map("invoice_id")
  createdById String?         @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lines             QuoteLine[]
  // Forward + back FK relations from business_fk_constraints migrations.
  deal              Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  invoice           Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  approval_requests ApprovalRequest[]
  orders            Order[]

  @@unique([tenantId, number])
  @@index([tenantId, companyId, issueDate])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("quotes")
}

model QuoteLine {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  quoteId     String   @map("quote_id")
  productId   String?  @map("product_id")
  position    Int
  description String   @db.VarChar(500)
  quantity    Decimal  @db.Decimal(14, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 2)
  vatRate     Decimal  @default(19) @map("vat_rate") @db.Decimal(5, 2)
  subtotal    Decimal  @db.Decimal(14, 2)
  vatAmount   Decimal  @map("vat_amount") @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_lines")
}

// ─── Email sequences (S32) ───────────────────────────────────────────────────
// Drip campaigns: a sequence of emails sent with configurable delays.

enum SequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  UNSUBSCRIBED
  FAILED
}

model EmailSequence {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  name        String
  description String?
  status      SequenceStatus @default(DRAFT)
  createdById String?        @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  steps       EmailSequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("email_sequences")
}

model EmailSequenceStep {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  sequenceId String   @map("sequence_id")
  order      Int
  delayDays  Int      @default(0) @map("delay_days")
  subject    String
  bodyHtml   String   @map("body_html")
  bodyText   String?  @map("body_text")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId, order])
  @@map("email_sequence_steps")
}

model SequenceEnrollment {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  sequenceId  String           @map("sequence_id")
  /// Contact email address
  toEmail     String           @map("to_email")
  contactId   String?          @map("contact_id")
  currentStep Int              @default(0) @map("current_step")
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now()) @map("enrolled_at")
