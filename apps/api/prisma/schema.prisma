// ─── S58 Marketing Campaigns ──────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  // Phase 1 — drag-drop builder + scheduler lifecycle
  SCHEDULED
  SENDING
  CANCELLED
}

enum CampaignChannel {
  EMAIL
  SMS
  WHATSAPP
  MIXED
}

model Campaign {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  name        String
  description String?
  status      CampaignStatus  @default(DRAFT)
  channel     CampaignChannel @default(EMAIL)
  segmentId   String?         @map("segment_id")
  startDate   DateTime?       @map("start_date")
  endDate     DateTime?       @map("end_date")
  budget      Decimal?        @db.Decimal(14, 2)
  currency    String          @default("RON")
  targetCount Int             @default(0) @map("target_count")
  sentCount   Int             @default(0) @map("sent_count")
  conversions Int             @default(0)
  revenue     Decimal         @default(0) @db.Decimal(14, 2)
  createdById String?         @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  // ─── Phase 1 — drag-drop email builder fields ────────────────────────
  // Addressing
  subject     String? @map("subject") @db.VarChar(998)
  fromName    String? @map("from_name") @db.VarChar(80)
  fromAddress String? @map("from_address") @db.VarChar(320)
  replyTo     String? @map("reply_to") @db.VarChar(320)
  previewText String? @map("preview_text") @db.VarChar(255)

  // Template (block tree + rendered caches; HTML/text computed at send time)
  templateJson Json?   @map("template_json")
  templateHtml String? @map("template_html") @db.VarChar(1048576)
  templateText String? @map("template_text") @db.VarChar(262144)

  // Scheduling + audience snapshot
  scheduledAt     DateTime? @map("scheduled_at")
  sentAt          DateTime? @map("sent_at")
  recipientFilter Json?     @map("recipient_filter")
  recipientCount  Int       @default(0) @map("recipient_count")

  // Engagement counters (denormalized from CampaignRecipient + EmailTrack;
  // a nightly reconcile job corrects drift).
  openCount        Int @default(0) @map("open_count")
  uniqueOpenCount  Int @default(0) @map("unique_open_count")
  clickCount       Int @default(0) @map("click_count")
  uniqueClickCount Int @default(0) @map("unique_click_count")
  bounceCount      Int @default(0) @map("bounce_count")
  unsubscribeCount Int @default(0) @map("unsubscribe_count")
  spamReportCount  Int @default(0) @map("spam_report_count")
  sentSuccessCount Int @default(0) @map("sent_success_count")
  sentFailureCount Int @default(0) @map("sent_failure_count")

  // Relations
  recipients CampaignRecipient[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  // Phase 1 — scheduler hot path. Matches partial index
  // campaigns_scheduler_pending_idx (Prisma can't express the WHERE filter,
  // so the partial index is created hand-rolled in the SQL migration).
  @@index([tenantId, scheduledAt])
  @@map("campaigns")
}

// ─── Phase 1 — CampaignRecipient (per-recipient send attribution) ────────

enum CampaignRecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
  SKIPPED
}

/// Polymorphic subject types for campaign audiences. Separate from the
/// global SubjectType (which covers Notes/Attachments/Activities) because
/// campaigns ALSO target Leads — and extending the global enum would force
/// a refactor of every consumer of that enum.
enum SubjectTypeExt {
  COMPANY
  CONTACT
  CLIENT
  LEAD
}

/// One row per (campaign, contact/lead) at audience materialization time.
/// Carries the per-recipient HMAC tracking token used to attribute opens/
/// clicks back to THIS recipient without leaking the email address in the
/// tracking URL. Counters are denormalized from EmailTrack for fast
/// per-recipient timeline reads.
model CampaignRecipient {
  id            String                  @id @default(cuid())
  tenantId      String                  @map("tenant_id")
  campaignId    String                  @map("campaign_id")
  subjectType   SubjectTypeExt          @map("subject_type")
  subjectId     String                  @map("subject_id")
  email         String                  @db.VarChar(320)
  trackingToken String                  @map("tracking_token") @db.VarChar(64)
  status        CampaignRecipientStatus @default(PENDING)

  // Lifecycle
  queuedAt    DateTime? @map("queued_at")
  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  bouncedAt   DateTime? @map("bounced_at")
  failedAt    DateTime? @map("failed_at")

  // Per-recipient engagement
  openCount   Int       @default(0) @map("open_count")
  clickCount  Int       @default(0) @map("click_count")
  lastOpenAt  DateTime? @map("last_open_at")
  lastClickAt DateTime? @map("last_click_at")

  // Diagnostic on failure
  errorCode    String? @map("error_code") @db.VarChar(64)
  errorMessage String? @map("error_message") @db.VarChar(2048)

  // Resulting EmailMessage row (NULL until SENT).
  messageId String? @map("message_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaign Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tracks   EmailTrack[]

  @@unique([campaignId, subjectType, subjectId], map: "campaign_recipients_campaign_subject_uniq")
  @@unique([trackingToken], map: "campaign_recipients_tracking_token_uniq")
  @@index([tenantId, campaignId, status], map: "campaign_recipients_tenant_campaign_status_idx")
  @@index([tenantId, subjectType, subjectId], map: "campaign_recipients_tenant_subject_idx")
  @@index([tenantId, email], map: "campaign_recipients_tenant_email_idx")
  @@map("campaign_recipients")
}

// ─── Validation Rules (custom field validation on entities) ───────────────────

enum ValidationEntityType {
  COMPANY
  CONTACT
  CLIENT
  DEAL
  LEAD
  CASE
  ORDER
}

enum ValidationOperator {
  REGEX
  MIN_LENGTH
  MAX_LENGTH
  EQUALS
  NOT_EQUALS
}

/**
 * Business rules applied pre-save on entity writes. Minimal expression engine:
 * a single `field` + operator + value. Complex boolean logic is intentionally
 * deferred — if you need AND/OR, create multiple rules.
 */
model ValidationRule {
  id           String               @id @default(cuid())
  tenantId     String               @map("tenant_id")
  entityType   ValidationEntityType @map("entity_type")
  field        String
  operator     ValidationOperator
  value        String
  errorMessage String               @map("error_message")
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@index([tenantId, entityType, isActive])
  @@map("validation_rules")
}

// ─── Formula Fields ───────────────────────────────────────────────────────────

/**
 * Tenant-defined computed fields. Expression references other fields by name.
 * Evaluation is deliberately sandboxed — no free-form JS. Operators: + - * /,
 * CONCAT(...), IF(cond, a, b). See FormulaEvaluator for exact grammar.
 */
model FormulaField {
  id         String               @id @default(cuid())
  tenantId   String               @map("tenant_id")
  entityType ValidationEntityType @map("entity_type")
  fieldName  String               @map("field_name")
  expression String
  returnType String               @default("STRING") @map("return_type")
  isActive   Boolean              @default(true) @map("is_active")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  @@unique([tenantId, entityType, fieldName])
  @@map("formula_fields")
}

